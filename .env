# ── LLM (Groq is free tier, same as ComplaintBot) ──────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Optional: OpenAI (used for embeddings if set; otherwise HuggingFace) ───
OPENAI_API_KEY=

# ── LLM settings ───────────────────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_MODEL=llama3-8b-8192
# Alternative: mixtral-8x7b-32768 (better reasoning, higher cost)

# ── Email (for voucher sending — optional) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# ── Paths ───────────────────────────────────────────────────────────────────
DB_PATH=chatbot.db
CHROMA_DIR=./chroma_db
POLICY_PATH=data/policy.md
ESCALATIONS_LOG=escalations.jsonl

# ── CORS (comma-separated origins for the widget embed) ────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,*
